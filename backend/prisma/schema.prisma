// prisma/schema.prisma
// SMM Panel Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  username          String      @unique
  password          String
  role              UserRole    @default(USER)
  status            UserStatus  @default(ACTIVE)
  balance           Decimal     @default(0) @db.Decimal(12, 4)
  profilePicture    String?
  
  // Password reset
  resetToken        String?
  resetTokenExpiry  DateTime?
  
  // Email verification
  emailVerified         Boolean   @default(false)
  emailVerifyCode       String?
  emailVerifyExpiry     DateTime?
  
  // Timestamps
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastLoginAt       DateTime?
  
  // Relations
  orders            Order[]
  topUpRequests     TopUpRequest[]
  transactions      Transaction[]
  apiKeys           ApiKey[]
  tickets           Ticket[]
  ticketMessages    TicketMessage[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  suggestions       Suggestion[]
  adminLogs         AdminLog[]      @relation("AdminLogs")
  
  @@index([email])
  @@index([username])
  @@index([status])
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// ============================================
// WALLET & TRANSACTIONS
// ============================================

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  GCASH
  PAYMAYA
  PAYPAL
  BANK_TRANSFER
  VISA
  MASTERCARD
  OTHER
}

model TopUpRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 4)
  paymentMethod   PaymentMethod
  referenceNumber String?
  proofUrl        String?
  status          TopUpStatus   @default(PENDING)
  adminNote       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  transaction     Transaction?
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum TransactionType {
  TOP_UP
  ORDER_PAYMENT
  ORDER_REFUND
  ADMIN_ADJUST
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 4)
  balanceBefore Decimal         @db.Decimal(12, 4)
  balanceAfter  Decimal         @db.Decimal(12, 4)
  description   String
  
  orderId       String?         @unique
  order         Order?          @relation(fields: [orderId], references: [id])
  topUpId       String?         @unique
  topUp         TopUpRequest?   @relation(fields: [topUpId], references: [id])
  
  createdAt     DateTime        @default(now())
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// SERVICES & CATEGORIES
// ============================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  services    Service[]
  
  @@index([isActive])
  @@index([sortOrder])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  TIKTOK
  YOUTUBE
  TELEGRAM
  DISCORD
  SPOTIFY
  TWITCH
  OTHER
}

model Service {
  id                String    @id @default(cuid())
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  providerId        String?
  provider          Provider? @relation(fields: [providerId], references: [id])
  
  name              String
  description       String?
  platform          Platform
  type              String
  
  rate              Decimal   @db.Decimal(12, 4)
  minQuantity       Int       @default(100)
  maxQuantity       Int       @default(10000)
  
  providerServiceId String?
  providerRate      Decimal?  @db.Decimal(12, 4)
  
  isActive          Boolean   @default(true)
  isDripFeed        Boolean   @default(false)
  isRefill          Boolean   @default(false)
  averageTime       String?
  
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  orders            Order[]
  
  @@index([categoryId])
  @@index([platform])
  @@index([isActive])
  @@index([providerId])
}

// ============================================
// PROVIDERS (External SMM APIs)
// ============================================

enum ProviderStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model Provider {
  id          String         @id @default(cuid())
  name        String         @unique
  apiUrl      String
  apiKey      String
  status      ProviderStatus @default(ACTIVE)
  balance     Decimal?       @db.Decimal(12, 4)
  description String?
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  services    Service[]
  orders      Order[]
  
  @@index([status])
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
  CANCELED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  serviceId         String
  service           Service     @relation(fields: [serviceId], references: [id])
  
  providerId        String?
  provider          Provider?   @relation(fields: [providerId], references: [id])
  providerOrderId   String?
  
  link              String
  quantity          Int
  startCount        Int?
  currentCount      Int?
  remains           Int?
  
  charge            Decimal     @db.Decimal(12, 4)
  cost              Decimal?    @db.Decimal(12, 4)
  
  comments          String?
  usernames         String?
  hashtags          String?
  customData        Json?
  
  dripFeed          Boolean     @default(false)
  dripFeedInterval  Int?
  dripFeedQuantity  Int?
  
  status            OrderStatus @default(PENDING)
  statusNote        String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  completedAt       DateTime?
  
  transaction       Transaction?
  
  @@index([userId])
  @@index([serviceId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@index([providerOrderId])
}

// ============================================
// API KEYS (Resellers)
// ============================================

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  key           String    @unique
  isActive      Boolean   @default(true)
  
  lastUsedAt    DateTime?
  requestCount  BigInt    @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
  @@index([key])
  @@index([isActive])
}

// ============================================
// SUPPORT TICKETS
// ============================================

enum TicketStatus {
  OPEN
  ANSWERED
  CUSTOMER_REPLY
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  
  orderId     String?
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?
  
  messages    TicketMessage[]
  
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  message     String   @db.Text
  attachments Json?
  isAdmin     Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// ADMIN LOGS
// ============================================

enum LogAction {
  USER_BAN
  USER_UNBAN
  USER_BALANCE_ADJUST
  SERVICE_CREATE
  SERVICE_UPDATE
  SERVICE_DELETE
  ORDER_UPDATE
  ORDER_CANCEL
  ORDER_REFUND
  TOPUP_APPROVE
  TOPUP_REJECT
  PROVIDER_CREATE
  PROVIDER_UPDATE
  SETTINGS_UPDATE
  OTHER
}

model AdminLog {
  id          String    @id @default(cuid())
  adminId     String
  admin       User      @relation("AdminLogs", fields: [adminId], references: [id])
  
  action      LogAction
  targetType  String
  targetId    String
  details     Json?
  ipAddress   String?
  
  createdAt   DateTime  @default(now())
  
  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

// ============================================
// SETTINGS (Key-Value Store)
// ============================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([key])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  ORDER_STATUS
  WALLET_TOPUP
  TICKET_REPLY
  SYSTEM_ANNOUNCEMENT
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        NotificationType
  title       String
  message     String           @db.Text
  link        String?
  isRead      Boolean          @default(false)
  
  createdAt   DateTime         @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// SUGGESTIONS
// ============================================

enum SuggestionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  IMPLEMENTED
  REJECTED
}

enum SuggestionCategory {
  FEATURE_REQUEST
  IMPROVEMENT
  BUG_REPORT
  UI_UX
  SERVICE_REQUEST
  OTHER
}

model Suggestion {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String             @db.Text
  category    SuggestionCategory @default(OTHER)
  status      SuggestionStatus   @default(PENDING)
  
  adminNote   String?            @db.Text
  reviewedBy  String?
  reviewedAt  DateTime?
  
  upvotes     Int                @default(0)
  
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}
